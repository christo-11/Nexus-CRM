# Copy this file to .env and replace every placeholder before starting the API.
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters

# connect-supabase.cmd securely replaces this placeholder after prompting for
# the database password. Do not put a real password in this file.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
CRM_ADMIN_NAME=Main Admin

FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:8080

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

MAX_CONTENT_LENGTH=10485760
# Optional: set this to a private, persistent directory. If omitted, the API
# uses flask-backend/instance/uploads locally.
# UPLOAD_FOLDER=
ACCESS_TOKEN_MINUTES=15
RESET_TOKEN_MAX_AGE=3600
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=0

AI_SUPPORT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_SUPPORT_CHAT_MODEL=llama3.2:3b
AI_SUPPORT_EMBEDDING_MODEL=nomic-embed-text
AI_SUPPORT_MIN_RELEVANCE=0.35
